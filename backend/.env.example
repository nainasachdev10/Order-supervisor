# Optional: set to enable real Claude-powered agent reasoning. If unset, a deterministic
# rule-based agent brain is used instead (fully functional for demo purposes).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Defaults to a local sqlite file. Point at Postgres/Supabase instead if you prefer, e.g.:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/order_supervisor
DATABASE_URL=sqlite+aiosqlite:///./order_supervisor.db

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TASK_QUEUE=order-supervisor-tq
